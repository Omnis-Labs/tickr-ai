# Backend production env vars.
# Copy these into your hosting provider's environment-variables UI.

# ---- LLM ------------------------------------------------------------------
LLM_BACKEND=gemini
GEMINI_API_KEY=your-key-here
# Optional: pin specific models. The defaults match dev.
# GEMINI_MODEL_CHEAP=gemini-2.5-flash-lite
# GEMINI_MODEL_DEFAULT=gemini-2.5-flash
# GEMINI_MODEL_PREMIUM=gemini-2.5-pro

# ---- Database (Supabase) --------------------------------------------------
# Supabase Settings → Database → Connection string → URI (asyncpg pool).
# Then prefix the scheme with "postgresql+asyncpg://".
DATABASE_URL=postgresql+asyncpg://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ---- Artifact storage (Supabase Storage) ---------------------------------
ARTIFACT_BACKEND=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key...
SUPABASE_STORAGE_BUCKET=artifacts

# ---- Cost governance -----------------------------------------------------
TASK1_BUDGET_USD=0.20
TASK2_BUDGET_USD=0.10
GLOBAL_DAILY_BUDGET_USD=10.0

# ---- Browser agent -------------------------------------------------------
PLAYWRIGHT_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
TASK1_MAX_RECOVERY_ATTEMPTS=3
TASK1_MAX_STEPS=20
# Comma-separated. Empty = allow any (DEV ONLY).
BROWSER_DOMAIN_ALLOWLIST=wikipedia.org,arxiv.org,news.ycombinator.com,httpbin.org

# ---- API server ----------------------------------------------------------
API_HOST=0.0.0.0
# PORT is provided by the platform; we read it via --port $PORT in start cmd.
# Set CORS to your Vercel domain(s).
CORS_ORIGINS=https://your-frontend.vercel.app

# ---- Observability -------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
