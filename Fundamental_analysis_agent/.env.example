# ============================================================================
# LLM Backend Selection
# ============================================================================
# Which LLM backend to use. Options:
#   anthropic  - Anthropic API (matches Claude CLI auth)
#   openai     - OpenAI API
#   gemini     - Google Gemini API (free tier available; good default for this project)
#   mock       - Deterministic mock for unit tests / offline dev
LLM_BACKEND=gemini

# Anthropic (default backend) — same key Claude CLI uses
# Get yours from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Default models per cost tier (see shared/llm_gateway.py for routing logic)
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
ANTHROPIC_MODEL_PREMIUM=claude-opus-4-7

# OpenAI (optional fallback)
OPENAI_API_KEY=sk-...
OPENAI_MODEL_CHEAP=gpt-4o-mini
OPENAI_MODEL_DEFAULT=gpt-4o
OPENAI_MODEL_PREMIUM=o1

# Google Gemini — get a free key at https://aistudio.google.com/apikey
# Required when LLM_BACKEND=gemini
GEMINI_API_KEY=AIza...
GEMINI_MODEL_CHEAP=gemini-2.5-flash-lite
GEMINI_MODEL_DEFAULT=gemini-2.5-flash
GEMINI_MODEL_PREMIUM=gemini-2.5-pro

# ============================================================================
# Cost Governance
# ============================================================================
TASK1_BUDGET_USD=0.20
TASK2_BUDGET_USD=0.10
GLOBAL_DAILY_BUDGET_USD=10.0

# ============================================================================
# Database (Supabase for prod, SQLite for local dev)
# ============================================================================
# Local dev (default): SQLite file
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db

# Production (Supabase): postgresql+asyncpg://...
# DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxx.supabase.co:5432/postgres

# ============================================================================
# Artifact Storage
# ============================================================================
# Local dev: filesystem
ARTIFACT_BACKEND=local
ARTIFACT_DIR=./data/artifacts

# Production: Supabase Storage
# ARTIFACT_BACKEND=supabase
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...
# SUPABASE_STORAGE_BUCKET=artifacts

# ============================================================================
# Browser Agent (Task 1)
# ============================================================================
PLAYWRIGHT_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
TASK1_MAX_RECOVERY_ATTEMPTS=3
TASK1_MAX_STEPS=20
# Domain allow-list (comma-separated). Empty = no restriction (DEV ONLY)
BROWSER_DOMAIN_ALLOWLIST=wikipedia.org,arxiv.org,news.ycombinator.com,httpbin.org

# ============================================================================
# Observability
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ============================================================================
# API Server
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://*.vercel.app

# ============================================================================
# Frontend (Next.js, set in Vercel for prod)
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
